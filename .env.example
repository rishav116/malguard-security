# ==========================================
# MALGUARD AI — Frontend Environment Configuration
# ==========================================

# 1. Supabase Authentication & Database
# Obtain these credentials from your Supabase Project Settings -> API:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. FastAPI Backend API URL
# In local development: defaults to http://127.0.0.1:8000 (leave blank or set explicitly)
# In production on Vercel: set to your deployed FastAPI backend HTTPS domain (e.g. Render, Railway, Fly.io, or VPS)
NEXT_PUBLIC_FASTAPI_URL=https://your-fastapi-backend.example.com
