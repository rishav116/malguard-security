# ==========================================
# MALGUARD AI — Backend Environment Template
# ==========================================

# Application Runtime Mode
ENVIRONMENT=production
DEBUG=False

# Cross-Origin Resource Sharing (CORS)
# Add your Vercel deployment URL(s) and local dev URLs separated by commas:
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:3000

# Supabase Identity Provider (Authentication & Authorization)
# Obtain these credentials from Supabase Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Demo / Offline Analyst Bypass (DISABLED by default; MUST be False in production)
ALLOW_DEMO_AUTH=False

# Database Persistence Configuration (Phase 4C)
REQUIRE_DB_PERSISTENCE=True
ALLOW_IN_MEMORY_FALLBACK=False

# ClamAV Signature Engine Daemon Integration
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SEC=2.0
CLAMAV_CLI_PATH=clamscan

# Machine Learning Model Path
ML_MODEL_PATH=app/ml/models/random_forest_v1.pkl

# Gemini AI Security Assistant (Malix AI)
# Obtain your Gemini API Key from Google AI Studio (https://aistudio.google.com/):
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_INPUT_CHARS=2000
